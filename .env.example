# Copy this file to .env and fill in real values.
# .env is gitignored — it never gets committed, so each deployment
# (local WAMP, InfinityFree, another host) can have its own values
# without touching any PHP code.

# ── App ──
APP_DEBUG=false
APP_TIMEZONE=Africa/Dar_es_Salaam

# Leave APP_BASE_PATH empty to auto-detect the folder the app is
# deployed into (recommended). Only set it if auto-detection is
# wrong for your setup (e.g. behind a reverse proxy).
APP_BASE_PATH=

# ── Database ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=church_cms
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── Security ──
SESSION_NAME=CHURCH_CMS_SESSION

# ── Email delivery ──
# PHP mail() must be configured in the hosting/PHP environment.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Church Communication

# ── OpenAI Responses API ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
